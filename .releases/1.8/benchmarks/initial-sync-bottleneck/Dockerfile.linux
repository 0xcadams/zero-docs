FROM node:22-bookworm-slim

RUN apt-get update \
  && apt-get install --yes --no-install-recommends ca-certificates g++ git make python3 time \
  && rm -rf /var/lib/apt/lists/*

RUN npm install --global pnpm@11.5.3

WORKDIR /workspace
COPY . .
RUN pnpm install --frozen-lockfile --filter zero-cache...

WORKDIR /workspace/packages/zero-cache
