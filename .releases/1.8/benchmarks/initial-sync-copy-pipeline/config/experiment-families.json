{
  "schemaVersion": 1,
  "status": "definition-only-do-not-execute",
  "digestContract": {
    "copy": "sha256 over every byte of one complete PostgreSQL binary COPY stream, including header and trailer",
    "content": "sha256 using zero-copy-pipeline-content-v1 framing over every replica column of every row in primary-key COLLATE BINARY order",
    "calibration": "candidate values are emitted as noncanonical and require review before being copied into a canonical profile"
  },
  "defaults": {
    "canonical": false,
    "validationMode": "calibration",
    "fixtureVersion": "copy-pipeline-experiments-v1",
    "fixtureSeed": 20250715,
    "workerCount": 5,
    "docker": {"cpus": 1, "memory": "3g", "nodeHeapMB": 2304},
    "cachePolicy": {
      "sqlite": "default",
      "mmapGiB": 0,
      "osPageCache": "cold-clone",
      "betweenRuns": "new-replica-file"
    },
    "sourceStrategy": {
      "clone": "template-database-per-profile",
      "reset": "drop-clone-after-run",
      "betweenTreatments": "fresh-clone"
    },
    "expected": {
      "rowCount": null,
      "copyBytes": null,
      "copyDigest": null,
      "contentDigest": null
    }
  },
  "generators": {
    "pareto-publication-v1": {
      "tableNames": "bench_table_0001 through bench_table_N",
      "sizes": "allocate totalRows by descending weights pow(rank + 1, -alpha), floor each share, then distribute the remainder in seeded table-name order",
      "randomOrder": "Fisher-Yates using xorshift32 initialized from fixtureSeed; never use Math.random",
      "schema": "id bigint primary key, tenant_id integer not null, sequence integer not null, payload text not null, marker bytea"
    },
    "schema-heavy-v1": {
      "tableNames": "schema_table_0001 through schema_table_N",
      "columns": "id bigint primary key followed by deterministic nullable text, integer, real, boolean, timestamp, jsonb, bytea, and array columns until columnCount",
      "occupancy": "the first tinyTableCount tables contain repeating 1..10 rows; all remaining tables are empty",
      "indexes": "allocate secondary indexes round-robin in table-name order with deterministic ascending, descending, composite, partial, and covering shapes"
    },
    "parameter-boundary-v1": {
      "schema": "id bigint primary key plus generated integer columns c0001..cNNNN",
      "columnCounts": "for each rowsPerStatement, emit floor(sqliteVariableLimit / rowsPerStatement) plus every delta, retaining values in 1..postgresColumnLimit",
      "tails": "emit fullBatchCount complete batches followed by exactly tailRows rows"
    },
    "estimator-v1": {
      "schema": "case-specific deterministic columns plus id bigint primary key",
      "statistics": "apply each analyze/staleness/bloat action exactly as listed after loading and before cloning"
    },
    "index-cache-v1": {
      "schema": "id bigint primary key, tenant_id integer, bucket integer, created_at timestamptz, payload text",
      "indexes": "expand the named topology deterministically from tenant_id, bucket, created_at, payload prefix, and composite variants"
    },
    "concurrent-buffering-v1": {
      "schema": "id bigint primary key, ordinal integer, payload text",
      "payload": "seeded incompressible ASCII generated from repeated sha256(seed, table, row, block) hex blocks"
    },
    "native-ingestor-v1": {
      "schema": "case-specific deterministic binary COPY columns plus id bigint primary key",
      "chunks": "split the exact binary COPY corpus using the named deterministic chunk pattern",
      "malformedCorpus": "derive truncation, field-count, length, trailer, and extension failures from the valid corpus outside timed regions"
    }
  },
