# syntax=docker/dockerfile:1@sha256:87999aa3d42bdc6bea60565083ee17e86d1f3339802f543c0d03998580f9cb89
ARG NODE_IMAGE=node:22-bookworm-slim@sha256:6c74791e557ce11fc957704f6d4fe134a7bc8d6f5ca4403205b2966bd488f6b3
FROM ${NODE_IMAGE}

RUN apt-get update \
  && apt-get install --yes --no-install-recommends ca-certificates g++ git libncurses-dev libreadline-dev make python3 time \
  && rm -rf /var/lib/apt/lists/*

RUN npm install --global pnpm@11.5.3

WORKDIR /workspace
COPY . .
COPY --from=benchmark src/pg-copy-parser.product.bench.ts packages/zero-cache/src/pg-copy-parser.product.bench.ts
COPY --from=benchmark src/initial-sync-copy-pipeline.product.bench.pg.ts packages/zero-cache/src/initial-sync-copy-pipeline.product.bench.pg.ts
RUN pnpm install --frozen-lockfile --filter zero-cache...

WORKDIR /workspace/local-zero-sqlite3
COPY --from=addon package.json binding.gyp shell.js ./
COPY --from=addon deps ./deps
COPY --from=addon lib ./lib
COPY --from=addon src ./src

WORKDIR /workspace
COPY --from=benchmark scripts/link-local-addon.mjs /tmp/link-local-addon.mjs
RUN node /tmp/link-local-addon.mjs \
      /workspace/local-zero-sqlite3 \
      /workspace/packages/zero-cache/node_modules/@rocicorp/zero-sqlite3 \
  && node packages/zero-cache/node_modules/@rocicorp/zero-sqlite3/deps/gen-unicode-case.mjs \
       > packages/zero-cache/node_modules/@rocicorp/zero-sqlite3/src/util/unicode_case_data.h \
  && pnpm --dir packages/zero-cache/node_modules/@rocicorp/zero-sqlite3 run build-release

WORKDIR /workspace/packages/zero-cache
